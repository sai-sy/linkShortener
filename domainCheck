#!/usr/bin/env bash
set -euo pipefail
domainCheck() {
  local domain="${1:-}"
  if [[ -z "$domain" ]]; then
    echo "Usage: domainCheck <domain>"
    return 2
  fi
  if whois "$domain" | tail -n 20 | grep -qi "not found"; then
    echo "AVAILABLE: $domain"
    return 0
  fi
  echo "UNAVAILABLE: $domain"
  return 1
}
domainCheck "$@"
